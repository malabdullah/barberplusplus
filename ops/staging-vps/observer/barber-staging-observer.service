[Unit]
Description=Manual Barber staging release observer (never deploys)
After=network-online.target chrony.service

[Service]
Type=oneshot
User=barber-staging-deploy
Group=barber-staging-deploy
ExecStart=/opt/barber-staging-observer/node /opt/barber-staging-observer/runner.mjs
LoadCredentialEncrypted=github-app-private-key.pem:/etc/credstore.encrypted/barber-staging-github-app-key.cred
StateDirectory=barber-staging-observer
StateDirectoryMode=0700
RuntimeDirectory=barber-staging-observer
RuntimeDirectoryMode=0700
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=NODE_OPTIONS NODE_PATH LD_PRELOAD LD_LIBRARY_PATH GH_TOKEN GITHUB_TOKEN GH_HOST
UMask=0077
TimeoutStartSec=8min
TimeoutStopSec=30s
KillMode=control-group
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
InaccessiblePaths=-/run/docker.sock -/run/barber-staging-broker.sock /opt/barber-staging/supabase /etc/credstore.encrypted
LimitCORE=0
TasksMax=64
MemoryMax=768M
CPUQuota=100%
StandardOutput=journal
StandardError=null
