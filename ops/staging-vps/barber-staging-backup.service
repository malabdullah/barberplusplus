[Unit]
Description=Consistent encrypted Barber staging backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/barber-staging-operations
Environment=PATH=/usr/bin:/bin
ExecStart=/opt/barber-staging-observer/node /opt/barber-staging-operations/scripts/capture-live-staging-backup.mjs --scheduled
ExecStopPost=/opt/barber-staging-observer/node /opt/barber-staging-operations/scripts/recover-live-staging-capture.mjs
TimeoutStartSec=900
TimeoutStopSec=420
KillMode=control-group
Restart=no
MemoryMax=768M
CPUQuota=100%
TasksMax=128
PrivateTmp=true
NoNewPrivileges=true

