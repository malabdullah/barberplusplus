# Local staging candidate only. Publishing/deployment needs separate approval.
# Empty context; local single-platform tests use --provenance=false (no push).
# docker build --provenance=false --platform linux/amd64 - < this-file
FROM --platform=$BUILDPLATFORM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS helper
ARG TARGETARCH
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOTELEMETRY=off
ADD --checksum=sha256:33d7537d588ea49458b9509bcf4554bdf5ceacc66da71e5caa1058ea3b689c3b https://codeload.github.com/tianon/gosu/tar.gz/6456aaa0f3c854d199d0f037f068eb97515b7513 /tmp/gosu.tar.gz
WORKDIR /src
RUN tar -xzf /tmp/gosu.tar.gz --strip-components=1 && go mod download && go mod verify
# No dependency changes; rebuild the same helper with the patched Go toolchain.
RUN GOOS=linux GOARCH="$TARGETARCH" go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/gosu .

FROM supabase/postgres:17.11.0.002@sha256:0450166354dc9c1d25f0322ac8b580774d4fb0184d2b087f6e4fe9499c66cf53
LABEL cloud.malabdullah.barber.staging.postgres-patch="gosu-go1.27.1-v1" \
      cloud.malabdullah.barber.staging.gosu-source="6456aaa0f3c854d199d0f037f068eb97515b7513" \
      org.opencontainers.image.base.name="supabase/postgres:17.11.0.002" \
      org.opencontainers.image.base.digest="sha256:0450166354dc9c1d25f0322ac8b580774d4fb0184d2b087f6e4fe9499c66cf53"
# The only added filesystem payload. Keep upstream entrypoint, user and command.
COPY --from=helper --chown=0:0 --chmod=0755 /out/gosu /usr/local/bin/gosu
