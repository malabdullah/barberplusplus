[Unit]
Description=Barber staging read-only broker foundation (deployment disabled)
Requires=barber-staging-broker.socket
After=barber-staging-broker.socket

[Service]
Type=simple
User=barber-staging-broker
Group=barber-staging-broker
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/barber-staging-broker/broker.py
WorkingDirectory=/
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/etc/dokploy -/etc/barber-staging-backup -/opt/barber-staging
TasksMax=8
MemoryMax=64M
CPUQuota=10%
LimitNOFILE=64
TimeoutStopSec=5
Restart=on-failure
RestartSec=5
StandardOutput=null
StandardError=journal
