[Unit]
Description=Renew the Barber++ Apple sign-in credential before expiry
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/lib/barber-release/apple_renewal.py
Restart=on-failure
RestartSec=1h
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/barber-release /var/lib/barber-release-backend
