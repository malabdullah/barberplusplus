[Unit]
Description=Report Apple cleanup credential expiry without rotation
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/lib/barber-release/apple_cleanup_renewal.py --check
TimeoutStartSec=5min
TimeoutStopSec=10s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
