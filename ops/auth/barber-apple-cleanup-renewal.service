[Unit]
Description=Renew the Barber++ Apple cleanup client pair before expiry
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/lib/barber-release/apple_cleanup_renewal.py
Restart=on-failure
RestartSec=1h
TimeoutStartSec=10min
TimeoutStopSec=10s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/barber-release /var/lib/barber-release-backend
