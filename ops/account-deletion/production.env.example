# Release candidate only. Defaults cannot activate real customer deletion.
# Do not add secret values to Git. Preserve the separate Test environment.
CUSTOMER_ACCOUNT_DELETION_ENABLED=false
CUSTOMER_ACCOUNT_DELETION_CLEANUP_ENABLED=false

# Set only after verifying the current production Functions backend binding.
# Observed production binding: http://api-gw:8000 (verified read-only 2026-11-13).
# Other explicit pins: http://kong:8000 or https://srv1073968.hstgr.cloud
CUSTOMER_ACCOUNT_DELETION_BACKEND_URL=

# Existing server-only transactional sender secret, supplied separately.
# RESEND_API_KEY is already used by approved booking/invitation email senders.
# Do not overwrite or rotate it as part of this feature.

# Independent Apple cleanup activation; keep false throughout preparation.
# Live requires BOTH exact native and web client credentials in one protected JSON
# value, each with clientId/clientSecret. Never copy Test credentials here.
CUSTOMER_APPLE_REVOCATION_ENABLED=false
CUSTOMER_APPLE_REVOCATION_CLIENTS=
# Separate random 256-bit key, 64 lowercase hex. Keep stable for all v1 envelopes.
CUSTOMER_APPLE_ENCRYPTION_KEY=
