# Self-hosted Supabase configuration
# View generated credentials on the Supabase host with: sh run.sh secrets

# Public HTTPS origin used by REST, Auth, Storage, Realtime, and Functions
VITE_SUPABASE_URL=https://supabase.malabdullah.cloud

# Browser-safe key only. Modern sb_publishable_ keys and legacy self-hosted
# anon-role JWTs are supported. Never use a secret or service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
