# Secret names only. Populate these in the staging deployment secret store.
APP_ENV=staging
APP_URL=https://staging-barber.malabdullah.cloud
SUPABASE_URL=https://supabase-staging.malabdullah.cloud
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-store
CRON_SHARED_SECRET=replace-in-secret-store
OUTBOUND_RECIPIENT_ALLOWLIST=replace-with-dedicated-test-recipient
SMTP_HOST=replace-with-sandbox-host
SMTP_PORT=587
SMTP_USERNAME=replace-in-secret-store
SMTP_PASSWORD=replace-in-secret-store
SMTP_FROM_ADDRESS=replace-with-sandbox-sender
WHATSAPP_PHONE_NUMBER_ID=replace-with-test-number-id
WHATSAPP_ACCESS_TOKEN=replace-in-secret-store
WHATSAPP_VERIFY_TOKEN=replace-in-secret-store
WHATSAPP_APP_ID=replace-with-test-app-id
WHATSAPP_APP_SECRET=replace-in-secret-store
WHATSAPP_SERVICE_FLOW_ID=replace-with-test-flow-id
WHATSAPP_BOOKING_FLOW_ID=replace-with-test-flow-id
WHATSAPP_FLOW_PRIVATE_KEY=replace-in-secret-store
ANTHROPIC_API_KEY=replace-with-restricted-staging-key
