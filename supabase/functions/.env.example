APP_ENV=development
APP_URL=http://127.0.0.1:5173
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are injected by
# the local CLI. Set environment-specific values only in the remote secret store.
CRON_SHARED_SECRET=replace-with-a-local-random-value
SMTP_HOST=local-mailpit
SMTP_PORT=1025
SMTP_USERNAME=local-test-only
SMTP_PASSWORD=local-test-only
SMTP_FROM_ADDRESS=barber-local@example.test
WHATSAPP_PHONE_NUMBER_ID=local-test-only
WHATSAPP_ACCESS_TOKEN=local-test-only
WHATSAPP_VERIFY_TOKEN=local-test-only
WHATSAPP_APP_ID=local-test-only
WHATSAPP_APP_SECRET=local-test-only
WHATSAPP_SERVICE_FLOW_ID=local-test-only
WHATSAPP_BOOKING_FLOW_ID=local-test-only
WHATSAPP_FLOW_PRIVATE_KEY=local-test-only
ANTHROPIC_API_KEY=local-test-only
OUTBOUND_RECIPIENT_ALLOWLIST=96500000000
