map $uri $barber_cache_control {
  default "no-cache";
  /runtime-config.js "no-store";
  /booking/share "private, no-store";
  /booking-share.html "private, no-store";
  ~^/email/ "no-store";
  ~^/assets/ "public, max-age=31536000, immutable";
}

map $uri $barber_robots {
  default "${ROBOTS_HEADER}";
  /booking/share "noindex, nofollow, noarchive";
  /booking-share.html "noindex, nofollow, noarchive";
}
map $uri $barber_referrer {
  default "strict-origin-when-cross-origin";
  /booking/share "no-referrer";
  /booking-share.html "no-referrer";
}

# Use the original URI: the SPA fallback rewrites $uri to /index.html.
map $request_uri $barber_opener_policy {
  default "same-origin";
  ~^/customer/delete-account(?:\?|$) "same-origin-allow-popups";
  ~^/customer/auth-callback(?:\?|$) "unsafe-none";
}
map $request_uri $barber_auth_cache {
  default $barber_cache_control;
  ~^/customer/auth-callback(?:\?|$) "no-store";
}
map $request_uri $barber_auth_referrer {
  default $barber_referrer;
  ~^/customer/auth-callback(?:\?|$) "no-referrer";
}
# Never record callback codes, shared tokens or a referring URL's query.
log_format barber_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  access_log /var/log/nginx/access.log barber_safe;

  add_header Cache-Control $barber_auth_cache always;
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: ${SUPABASE_PUBLIC_URL}; connect-src 'self' ${SUPABASE_PUBLIC_URL} ${SUPABASE_REALTIME_URL} https://ipapi.co https://identitytoolkit.googleapis.com https://www.google.com/recaptcha/; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; form-action 'self'; upgrade-insecure-requests" always;
  add_header Cross-Origin-Opener-Policy $barber_opener_policy always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Referrer-Policy "$barber_auth_referrer" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-Robots-Tag "$barber_robots" always;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /booking/share {
    try_files /booking-share.html =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
