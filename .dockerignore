# Only send inputs read by the Dockerfile. Private workspace data never enters
# the build context, including when a developer builds from a dirty checkout.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!index.html
!booking-share.html
!vite.config.js
!public/
!public/**
!src/
!src/**
!docker/
!docker/runtime-config.js.template
!docker/nginx.conf.template
!docker/20-configure-runtime.sh
**/.env
**/.env.*
**/.DS_Store
