{
  "name": "barber-plus-plus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "local:bootstrap": "sh scripts/bootstrap-local.sh",
    "local:start": "sh scripts/start-local.sh",
    "local:stop": "supabase stop",
    "baseline:local:start": "sh scripts/prepare-baseline-local.sh",
    "baseline:local:stop": "sh scripts/stop-baseline-local.sh",
    "supabase:reset": "supabase db reset --local",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:functions": "deno lint supabase/functions",
    "check:functions": "deno check --frozen supabase/functions/*/index.ts",
    "test:functions": "deno test --frozen --allow-env supabase/functions",
    "test": "vitest run",
    "test:cicd": "sh scripts/test-cicd.sh",
    "test:release": "node --test scripts/release-manifest.node-test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:domains": "sh scripts/check-hardcoded-domains.sh",
    "check:migrations": "sh scripts/verify-migration-names.sh",
    "check:staging-preflight": "sh scripts/staging-preflight.sh",
    "backup:staging-local": "sh scripts/backup-local-staging.sh",
    "deploy:staging-functions-local": "sh scripts/deploy-local-staging-functions.sh",
    "deploy:staging-frontend-local": "sh scripts/deploy-local-staging-frontend.sh",
    "check:staging-boundary": "sh scripts/validate-staging-boundary.sh",
    "check": "npm run lint && npm run lint:functions && npm run check:functions && npm run test:functions && npm run test && npm run test:cicd && npm run test:release && npm run build && npm run check:domains"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "date-fns": "^2.30.0",
    "dompurify": "3.4.13",
    "i18next": "^25.7.3",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.0",
    "react-router-dom": "7.18.3",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "deno": "2.9.5",
    "eslint": "10.9.1",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "supabase": "2.116.0",
    "vite": "^7.3.0",
    "vitest": "3.2.7"
  }
}
