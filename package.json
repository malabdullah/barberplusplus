{
  "name": "barber-plus-plus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloud-test": "npm run build && node ops/cloud-test/assets.mjs manifest",
    "test:cloud-gateway": "node --test ops/cloud-test/worker.test.mjs",
    "test:cloud-backend": "node ops/cloud-test/probe.mjs",
    "test:e2e:cloud": "playwright test --config playwright.cloud-test.config.js",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:functions": "deno lint supabase/functions",
    "check:functions": "deno check --frozen supabase/functions/*/index.ts",
    "test:functions": "deno test --frozen --allow-env supabase/functions",
    "test": "vitest run",
    "test:e2e:qa": "playwright test --config playwright.qa.config.js",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:domains": "sh scripts/check-hardcoded-domains.sh",
    "check:migrations": "sh scripts/verify-migration-names.sh",
    "local:setup": "npm ci && node scripts/local-test.mjs setup",
    "local:start": "node scripts/local-test.mjs start",
    "local:stop": "node scripts/local-test.mjs stop",
    "local:reset": "node scripts/local-test.mjs reset",
    "local:status": "node scripts/local-test.mjs status",
    "test:operations": "node --test scripts/*.node-test.mjs ops/release/*.test.mjs ops/backup/*.test.mjs",
    "test:production-image": "node scripts/test-production-image.mjs",
    "check:schema": "sh scripts/check-schema-drift.sh",
    "check": "npm run lint && npm run lint:functions && npm run check:functions && npm run test:functions && npm run test && npm run test:operations && npm run check:migrations && npm run check:domains && npm run build",
    "test:local-backend": "node scripts/probe-local-backend.mjs",
    "test:local-lifecycle": "node scripts/verify-local-lifecycle.mjs",
    "test:cloud-customer": "node ops/cloud-test/customer-probe.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "date-fns": "^2.30.0",
    "dompurify": "3.4.17",
    "i18next": "^25.7.3",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.0",
    "react-router-dom": "7.18.3",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "deno": "2.9.5",
    "eslint": "10.9.1",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "supabase": "2.116.0",
    "vite": "^7.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.156.0"
  }
}
